<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_lista">

    <fragment
        android:id="@+id/navigation_lista"
        android:name="com.example.agendaandroid.ListaFragment"
        android:label="Lista"
        tools:layout="@layout/fragment_lista" />

    <fragment
        android:id="@+id/navigation_agregar"
        android:name="com.example.agendaandroid.AgregarFragment"
        android:label="Agregar"
        tools:layout="@layout/fragment_agregar" />

    <fragment
        android:id="@+id/navigation_completadas"
        android:name="com.example.agendaandroid.CompletadasFragment"
        android:label="Completadas"
        tools:layout="@layout/fragment_completadas" />

    <fragment
        android:id="@+id/navigation_calendario"
        android:name="com.example.agendaandroid.CalendarioFragment"
        android:label="Calendario"
        tools:layout="@layout/fragment_calendario" />


    <fragment
        android:id="@+id/navigation_info"
        android:name="com.example.agendaandroid.InfoFragment"
        android:label="Info"
        tools:layout="@layout/fragment_info" />
</navigation>
