<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- 🔹 Título -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agregar Tarea"
            android:textColor="#C9A7EB"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="20dp" />

        <!-- 🔹 Campo Asignatura -->
        <EditText
            android:id="@+id/etAsignatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Asignatura"
            android:background="@drawable/edittext_bg"
            android:padding="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:layout_marginBottom="14dp"
            android:elevation="2dp" />

        <!-- 🔹 Campo Descripción -->
        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descripción"
            android:background="@drawable/edittext_bg"
            android:padding="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:layout_marginBottom="14dp"
            android:elevation="2dp" />

        <!-- 🔹 Campo Fecha -->
        <EditText
            android:id="@+id/etFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fecha (DD-MM-AAAA)"
            android:inputType="number"
            android:maxLength="10"
            android:background="@drawable/edittext_bg"
            android:padding="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:layout_marginBottom="26dp"
            android:elevation="2dp" />



        <!-- 🔹 Botón para seleccionar imagen -->

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="96dp"
            android:layout_height="82dp"
            android:layout_gravity="center"
            android:layout_marginBottom="12dp"
            android:background="@drawable/borde_imagen"
            android:contentDescription="Vista previa de imagen"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery" />

        <!-- 🔹 Botón circular de guardar -->
        <Button
            android:id="@+id/btnSeleccionarImagen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="30dp"
            android:backgroundTint="#AB47BC"
            android:elevation="4dp"
            android:text="Seleccionar Imagen"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_circular"
            android:elevation="10dp"
            android:text="💾"
            android:textSize="30sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:contentDescription="Guardar" />

    </LinearLayout>
</ScrollView>